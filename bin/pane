#!/usr/bin/env python3
"""pane: claim, renew and release a pane on the viewport bus.

One stdlib file (Python 3.11+), runnable from a clone or copied onto a PATH.
The bus contracts (paths, manifest.json, the liveness rule) and the rubric
live in docs/concept.md ("Contracts v1", "Rubric v1"); the page for humans and
Claudes is docs/claiming-the-display.md. Exit codes: 0 ok, 1 refused (reason
on stderr), 2 usage.
"""

import argparse
import getpass
import json
import math
import os
import re
import shutil
import socket
import sys
from datetime import datetime, timedelta, timezone

DEFAULT_BUS = "/mnt/lentago/web/viewport"
URL_BASE = "http://pub.lan/viewport"

# Rubric v1 default TTLs in minutes; None where the rubric has no fixed number.
CLASS_TTL = {
    "alert": 60,
    "attention": 240,
    "live": None,
    "activity": 60,
    "focus": 10,
    "ambient": None,
    "briefing": None,
}
ORIGINS = ("operator", "fleet")

PANE_ID = re.compile(r"[a-z0-9][a-z0-9-]{0,62}\Z")
REPO = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\Z")
EXTERNAL = (
    re.compile(r"<script\b[^>]*?\bsrc\s*=[^>]*", re.I),
    re.compile(r"<link\b[^>]*?\bhref\s*=[^>]*", re.I),
    re.compile(r"\bsrc\s*=\s*[\"']?https?:[^\s>]*", re.I),
)


THEMES = ("dark", "light")
VIEWPORT = re.compile(r"(\d+)x(\d+)\Z")
VIEWPORT_RANGE = (240, 3840)   # CSS pixels, each of width and height
MIN_REFRESH_S = 10
# Mirrors compositor/rubric.py: query or fragment parameters that usually carry
# a secret, refused because a link pane's URL is readable on the LAN.
SECRET_PARAM = re.compile(r"token|secret|signature|passw|credential|api[-_]?key", re.I)
SECRET_NAMES = {"key", "sig", "jwt", "session", "code", "pass", "pwd", "auth", "authorization"}


class Refused(Exception):
    """A request the bus rules forbid; the message is the reason."""


def utc_now():
    return datetime.now(timezone.utc)


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(text):
    if not isinstance(text, str):
        raise ValueError("not a string")
    if text.endswith(("Z", "z")):
        text = text[:-1] + "+00:00"
    dt = datetime.fromisoformat(text)  # 3.9 has no "Z" support, hence above
    if dt.tzinfo is None:
        raise ValueError("no timezone")
    return dt.astimezone(timezone.utc)


def default_author():
    return "%s@%s" % (getpass.getuser(), socket.gethostname())


def check_id(pane_id):
    if not PANE_ID.match(pane_id):
        raise Refused("invalid pane id %r (want [a-z0-9][a-z0-9-]{0,62})"
                      % pane_id)


def check_ttl(ttl, now):
    if not (isinstance(ttl, (int, float)) and math.isfinite(ttl) and ttl > 0):
        raise Refused("--ttl must be a positive number of minutes")
    try:
        now + timedelta(minutes=ttl)
    except OverflowError:
        raise Refused("--ttl is too large to represent as an expiry time")


def check_page(html):
    if not html.strip():
        raise Refused("pane page is empty")
    for pattern in EXTERNAL:
        m = pattern.search(html)
        if m:
            raise Refused("external reference %r: panes are self-contained "
                          "(inline the CSS and JS)" % m.group(0).strip())


def link_source(url, theme=None, screens=None, viewport=None, refresh=None):
    """The manifest ``source`` of a link pane (ADR-0016): a web page shown
    instead of pane.html. Mirrors the compositor's rules (rubric.parse_source)
    so a bad claim is refused here rather than skipped there."""
    from urllib.parse import parse_qsl, urlsplit
    if len(url) > 2048 or any(c.isspace() for c in url):
        raise Refused("--url is not a URL")
    try:
        parts = urlsplit(url)
        host = parts.hostname
    except ValueError:
        raise Refused("--url is not a URL")
    if parts.scheme not in ("http", "https") or not host:
        raise Refused("--url must be an http(s) URL")
    if parts.username is not None or parts.password is not None:
        raise Refused("--url must not carry a user or password: the pointer "
                      "is readable on the LAN")
    secrets = [name for part in (parts.query, parts.fragment)
               for name, _ in parse_qsl(part, keep_blank_values=True)
               if SECRET_PARAM.search(name) or name.lower() in SECRET_NAMES]
    if secrets:
        raise Refused("--url looks like it carries a secret (%s): the pointer is "
                      "readable on the LAN" % ", ".join(secrets))
    source = {"url": url}
    if theme is not None:
        source["theme"] = theme
    if screens is not None:
        if not 1 <= screens <= 4:
            raise Refused("--screens must be 1-4")
        source["screens"] = screens
    if viewport is not None:
        m = VIEWPORT.match(viewport)
        lo, hi = VIEWPORT_RANGE
        if not m or not all(lo <= int(v) <= hi for v in m.groups()):
            raise Refused("--viewport must be WIDTHxHEIGHT in CSS pixels, "
                          "each %d-%d" % VIEWPORT_RANGE)
        source["viewport"] = [int(v) for v in m.groups()]
    if refresh is not None:
        if not (math.isfinite(refresh) and refresh >= MIN_REFRESH_S):
            raise Refused("--refresh must be at least %d seconds" % MIN_REFRESH_S)
        source["refresh_s"] = refresh
    return source


def atomic_write(path, text):
    """Write ``path`` via ``path.partial`` and a rename, so readers never see
    a half-written file."""
    partial = path + ".partial"
    with open(partial, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(partial, path)


def panes_dir(bus):
    if not os.path.isdir(bus):
        raise Refused("bus root %s does not exist (is the share mounted? "
                      "see --bus / VIEWPORT_DIR)" % bus)
    return os.path.join(bus, "panes")


def read_manifest(pane_dir):
    """Return the manifest dict, or raise Refused naming the problem."""
    path = os.path.join(pane_dir, "manifest.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        raise Refused("no manifest.json in %s" % pane_dir)
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        raise Refused("manifest does not parse: %s" % exc)
    if not isinstance(data, dict):
        raise Refused("manifest is not a JSON object")
    return data


def owned_manifest(bus, pane_id, author):
    """Return ``(pane_dir, manifest)`` for a pane the caller owns, else refuse."""
    check_id(pane_id)
    pane_dir = os.path.join(panes_dir(bus), pane_id)
    if not os.path.isdir(pane_dir):
        raise Refused("no such pane %r" % pane_id)
    manifest = read_manifest(pane_dir)
    if manifest.get("author") != author:
        raise Refused("pane %r belongs to %s, not %s; only its author may "
                      "change it" % (pane_id, manifest.get("author"), author))
    return pane_dir, manifest


def claim(bus, pane_id, cls, title, page, now, ttl=None, origin="operator",
          repo=None, dwell=None, author=None, source=None):
    """Write the pane. With ``source`` (see ``link_source``) it is a link pane:
    no page, and the manifest names the web page instead."""
    author = author or default_author()
    check_id(pane_id)
    if cls not in CLASS_TTL:
        raise Refused("unknown class %r (one of %s)"
                      % (cls, ", ".join(CLASS_TTL)))
    if not title.strip():
        raise Refused("--title is empty")
    if ttl is None:
        ttl = CLASS_TTL[cls]
        if ttl is None:
            raise Refused("class %r has no fixed default TTL; pass --ttl MIN"
                          % cls)
    check_ttl(ttl, now)
    if repo is not None and not REPO.match(repo):
        raise Refused("--repo %r is not owner/name" % repo)
    if dwell is not None and not (math.isfinite(dwell) and dwell > 0):
        raise Refused("--dwell must be a positive number of seconds")
    if source is None:
        check_page(page)
    elif page is not None:
        raise Refused("a link pane has no page: pass --url or pane.html, not both")

    base = panes_dir(bus)
    pane_dir = os.path.join(base, pane_id)
    if os.path.isdir(pane_dir):
        # Re-claiming your own pane is fine; replacing another writer's is
        # the one thing the bus forbids.
        owned_manifest(bus, pane_id, author)
    os.makedirs(pane_dir, exist_ok=True)

    manifest = {
        "schema": 1,
        "class": cls,
        "title": title,
        "created": iso(now),
        "ttl_minutes": ttl,
        "author": author,
        "origin": origin,
    }
    if repo is not None:
        manifest["repo"] = repo
    if dwell is not None:
        manifest["dwell_s"] = dwell
    if source is not None:
        manifest["source"] = source
        atomic_write(os.path.join(pane_dir, "manifest.json"),
                     json.dumps(manifest, indent=2) + "\n")
        try:   # a page left from an earlier claim of this pane is now unused
            os.unlink(os.path.join(pane_dir, "pane.html"))
        except FileNotFoundError:
            pass
        return source["url"]
    atomic_write(os.path.join(pane_dir, "pane.html"), page)
    atomic_write(os.path.join(pane_dir, "manifest.json"),
                 json.dumps(manifest, indent=2) + "\n")  # manifest last
    return "%s/panes/%s/pane.html" % (URL_BASE, pane_id)


def renew(bus, pane_id, now, ttl=None, author=None):
    author = author or default_author()
    if ttl is not None:
        check_ttl(ttl, now)
    pane_dir, manifest = owned_manifest(bus, pane_id, author)
    manifest["created"] = iso(now)
    if ttl is not None:
        manifest["ttl_minutes"] = ttl
    atomic_write(os.path.join(pane_dir, "manifest.json"),
                 json.dumps(manifest, indent=2) + "\n")


def release(bus, pane_id, author=None):
    author = author or default_author()
    pane_dir, _ = owned_manifest(bus, pane_id, author)
    shutil.rmtree(pane_dir)


def describe_pane(pane_dir, now):
    """Return ``(class, origin, author, expires)`` columns for one pane
    directory; ``expires`` is a timestamp, "expired", "partial" or
    "malformed"."""
    try:
        files = set(os.listdir(pane_dir))
    except OSError:
        return "-", "-", "-", "partial"
    blank = ("-", "-", "-")
    if "manifest.json" not in files or any(name.endswith(".partial") for name in files):
        return blank + ("partial",)
    if "pane.html" not in files:
        # A link pane (a manifest `source`, ADR-0016) needs no pane.html.
        try:
            link = "source" in read_manifest(pane_dir)
        except Refused:
            link = False
        if not link:
            return blank + ("partial",)
    try:
        data = read_manifest(pane_dir)
        cls, author = data["class"], data["author"]
        ttl = data["ttl_minutes"]
        created = parse_time(data["created"])
        if (cls not in CLASS_TTL or not isinstance(data["title"], str)
                or not isinstance(author, str) or isinstance(ttl, bool)
                or not isinstance(ttl, (int, float)) or not ttl > 0):
            raise ValueError("bad field")
        origin = data.get("origin", "fleet")
        if origin not in ORIGINS:
            raise ValueError("bad origin")
        source = data.get("source", {"url": ""})
        if not (isinstance(source, dict) and isinstance(source.get("url"), str)):
            raise ValueError("bad source")   # the compositor's full rules: rubric.parse_source
        expires = created + timedelta(minutes=ttl)
    except (Refused, KeyError, ValueError, OverflowError):
        return blank + ("malformed",)
    return cls, origin, author, "expired" if expires <= now else iso(expires)


def list_panes(bus, now):
    base = panes_dir(bus)
    rows = []
    try:
        names = sorted(os.listdir(base))
    except FileNotFoundError:
        names = []
    for name in names:
        pane_dir = os.path.join(base, name)
        if os.path.isdir(pane_dir):
            rows.append((name,) + describe_pane(pane_dir, now))
    lines = []
    if rows:
        widths = [max(len(r[i]) for r in rows) for i in range(4)]
        for r in rows:
            lines.append("  ".join(r[i].ljust(widths[i]) for i in range(4))
                         + "  " + r[4])
    else:
        lines.append("(no panes)")
    lines.append(current_line(bus))
    return lines


def current_line(bus):
    try:
        with open(os.path.join(bus, "current.json"), encoding="utf-8") as f:
            ptr = json.load(f)
        if ptr.get("pane"):
            return "current: %s (%s) %s" % (ptr["pane"], ptr.get("class"),
                                            ptr.get("url"))
        return "current: fallback %s %s" % (ptr.get("fallback"),
                                            ptr.get("url"))
    except (OSError, ValueError, AttributeError):
        return "current: unavailable (no readable current.json)"


def build_parser():
    p = argparse.ArgumentParser(
        prog="pane", description="Claim, renew and release a pane on the "
        "viewport bus. See docs/claiming-the-display.md.")
    p.add_argument("--bus", default=os.environ.get("VIEWPORT_DIR", DEFAULT_BUS),
                   help="bus root (default: $VIEWPORT_DIR or %s)" % DEFAULT_BUS)
    sub = p.add_subparsers(dest="command", required=True, metavar="command")

    c = sub.add_parser("claim", help="put a pane on the bus")
    c.add_argument("id")
    c.add_argument("--class", dest="cls", required=True,
                   choices=list(CLASS_TTL))
    c.add_argument("--title", required=True)
    c.add_argument("--ttl", type=finite, metavar="MIN")
    c.add_argument("--origin", choices=ORIGINS, default="operator")
    c.add_argument("--repo", metavar="owner/name")
    c.add_argument("--dwell", type=finite, metavar="SEC")
    c.add_argument("--author", help="default: <user>@<hostname>")
    c.add_argument("page", metavar="pane.html", nargs="?",
                   help="page file, or - for stdin; omit with --url")
    link = c.add_argument_group(
        "link pane", "show a web page instead of pane.html (ADR-0016); the "
        "compositor shows link panes only once they are turned on")
    link.add_argument("--url", help="the page to show (http or https); the whole URL, "
                      "query string included, is readable on the LAN")
    link.add_argument("--theme", choices=THEMES, help="default: dark")
    link.add_argument("--screens", type=int, metavar="N",
                      help="bands of the page to show, each one viewport high, 1-4 (default 1)")
    link.add_argument("--viewport", metavar="WxH",
                      help="CSS size to lay the page out at (default 1280x720)")
    link.add_argument("--refresh", type=finite, metavar="SEC",
                      help="render it again this often, at least %d (default 60)"
                           % MIN_REFRESH_S)

    r = sub.add_parser("renew", help="slide a pane's TTL from now")
    r.add_argument("id")
    r.add_argument("--ttl", type=finite, metavar="MIN")
    r.add_argument("--author", help="default: <user>@<hostname>")

    d = sub.add_parser("release", help="remove your pane")
    d.add_argument("id")
    d.add_argument("--author", help="default: <user>@<hostname>")

    sub.add_parser("ls", help="list panes and the current decision")
    return p


def read_page(path):
    try:
        if path == "-":
            return sys.stdin.read()
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError) as exc:
        raise Refused("cannot read page %s: %s" % (path, exc))


def finite(text):
    """argparse type: a finite number; ``nan`` and ``inf`` are usage errors."""
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError("%r is not a number" % text)
    if not math.isfinite(value):
        raise argparse.ArgumentTypeError("%r is not a finite number" % text)
    return value


def whole(n):
    return int(n) if n is not None and n == int(n) else n


def main(argv=None, now=None):
    parser = build_parser()
    # Python before 3.12 leaves an optional positional (the page) that follows
    # options unmatched; take it from the leftovers instead.
    args, extra = parser.parse_known_args(argv)
    if extra and args.command == "claim" and args.page is None and len(extra) == 1 \
            and (extra[0] == "-" or not extra[0].startswith("-")):
        args.page, extra = extra[0], []
    if extra:
        parser.error("unrecognized arguments: %s" % " ".join(extra))
    now = now or utc_now()
    if args.command == "claim":   # usage errors (exit 2), before anything is read
        link_opts = (args.theme, args.screens, args.viewport, args.refresh)
        if args.url is None and any(v is not None for v in link_opts):
            parser.error("--theme, --screens, --viewport and --refresh need --url")
        if args.url is None and args.page is None:
            parser.error("pass pane.html (or - for stdin), or --url for a link pane")
        if args.url is not None and args.page is not None:
            parser.error("a link pane has no page: pass --url or pane.html, not both")
    try:
        if args.command == "claim":
            source = None if args.url is None else link_source(
                args.url, args.theme, args.screens, args.viewport, whole(args.refresh))
            page = None if args.page is None else read_page(args.page)
            url = claim(args.bus, args.id, args.cls, args.title, page, now,
                        ttl=whole(args.ttl), origin=args.origin, repo=args.repo,
                        dwell=whole(args.dwell), author=args.author, source=source)
            print(url)
        elif args.command == "renew":
            renew(args.bus, args.id, now, ttl=whole(args.ttl),
                  author=args.author)
        elif args.command == "release":
            release(args.bus, args.id, author=args.author)
        else:
            for line in list_panes(args.bus, now):
                print(line)
    except Refused as exc:
        print("pane: refused: %s" % exc, file=sys.stderr)
        return 1
    except OSError as exc:
        print("pane: refused: %s" % exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
